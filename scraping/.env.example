# =============================================================================
# Scraping — local Chrome workers (JobRight / ZipRecruiter / Glassdoor / Midh)
# Copy to .env and fill in values. API/Gmail/Redis vars belong in backend/.env.
# =============================================================================

# Chrome
CHROME_APP_PATH=/usr/bin/google-chrome-beta
# Absolute path preferred; relative paths resolve from scraping/
SCRAPING_CHROME_DIR=/home/yourusername/Desktop/Saral-Job-Viewer/scraping/zata/irangarick
SCRAPING_PORT=9003
USE_UNDETECTED_CHROME=1

# Relative to scraping/
DATA_DIR=zata

# Optional seed keywords (runtime keywords usually come from MongoDB)
SCRAPER_SEARCH_KEYWORDS="devops, cloud engineer, site reliability engineer, database administrator, platform engineer, data engineer"

SCRAPING_STALE_RETRIES=3
SCRAPING_STALE_DELAY=0.85
SCRAPING_HEADLESS=0
CLOSE_ON_COMPLETE=1

# MongoDB + Midhtech (scrapers + local validation.py)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?appName=SaralJobViewer
MONGODB_DATABASE=saralJobViewer
MIDHTECH_EMAIL=your-email@example.com
MIDHTECH_PASSWORD=your-password

# API the scraper talks to after a run
SARAL_API_BASE_URL=http://127.0.0.1:9260
